              ],
              "path": [
                "api",
                "cafeterias",
                "1",
                "seats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Summary total matches number of seats', () => pm.expect(body.summary.total).to.eql(body.data.length));",
                  "pm.test('Summary counts add up', () => { const s = body.summary; pm.expect(s.available + s.held + s.occupied + s.unavailable).to.eql(s.total); });",
                  "pm.test('Every seat has a valid status', () => body.data.forEach(seat => pm.expect(['available','held','occupied','unavailable']).to.include(seat.status)));",
                  "pm.test('Seat 12 is unavailable', () => pm.expect(body.data.find(s => s.seat_id === 12).status).to.eql('unavailable'));"
                ]
              }
            }
          ]
        },
