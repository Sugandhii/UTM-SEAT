  "item": [
    {
      "name": "TEST-02 Location Verification",
      "item": [
        {
          "name": "TC-02-01 Student at cafeteria centre is inside",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cafeterias/1/verify-location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cafeterias",
                "1",
                "verify-location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 1.5582,\n  \"longitude\": 103.639\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Inside the geofence', () => pm.expect(body.data.within_geofence).to.eql(true));",
                  "pm.test('Distance is 0 m', () => pm.expect(body.data.distance_meters).to.eql(0));",
                  "pm.test('Can book', () => pm.expect(body.data.can_book).to.eql(true));",
                  "pm.collectionVariables.set('geofenceEnabled', String(body.data.geofence_enabled));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-02-02 Student about 45 m away is inside",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
