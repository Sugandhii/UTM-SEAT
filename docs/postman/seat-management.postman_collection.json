              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const geofenceOn = pm.collectionVariables.get('geofenceEnabled') === 'true';",
                  "pm.test('Rejected when geofence is on, allowed when off', () => {",
                  "  if (geofenceOn) { pm.response.to.have.status(403); pm.expect(body.code).to.eql('LOCATION_NOT_VERIFIED'); }",
                  "  else { pm.response.to.have.status(201); }",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/api/bookings/' + body.data.booking_id + '/cancel', method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify({ user_id: 2 }) } });",
                  "}"
                ]
              }
            }
