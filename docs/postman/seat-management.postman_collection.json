      "name": "TEST-03 Seating Availability",
      "item": [
        {
          "name": "TC-03-01 List seats of Arked Meranti",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cafeterias/1/seats",
              "host": [
