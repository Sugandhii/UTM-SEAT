PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=utm_seat

# Seat booking: how many minutes a seat stays held before it must be confirmed
HOLD_DURATION_MINUTES=5

# GPS geofencing: true = students must be inside the cafeteria to book.
# Set to false while developing at home so booking still works.
GEOFENCE_ENABLED=true
